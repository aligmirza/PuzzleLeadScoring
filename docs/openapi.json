  "components": {
    "schemas": {
      "AiIn": {
        "properties": {
          "phase": {
            "type": "string",
            "enum": [
              "icp",
              "signals"
            ],
            "title": "Phase",
            "description": "icp: settle PENDING verdicts; signals: AI-only signals and score"
          },
          "ai_options": {
            "$ref": "#/components/schemas/AiOptions",
            "default": {
              "web": true,
              "search_signals": true
            }
          }
        },
        "type": "object",
        "required": [
          "phase"
        ],
        "title": "AiIn"
      },
      "AiOptions": {
        "properties": {
          "mode": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "accurate",
                  "cheap"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Mode",
            "description": "accurate: one AI call per data point (default). cheap: grouped calls, about 3 times cheaper"
          },
          "web": {
            "type": "boolean",
            "title": "Web",
            "description": "Allow web search (step 2)",
            "default": true
          },
          "search_signals": {
            "type": "boolean",
            "title": "Search Signals",
            "description": "Phase 2: ask the buying signals only web search can answer (about $0.10 per ICP company in accurate mode)",
            "default": true
          },
          "max_cost_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Cost Usd",
            "description": "Refuse the AI step if the estimate could exceed this. Default: API_AI_MAX_COST_USD in .env, else 5"
          }
        },
        "type": "object",
        "title": "AiOptions"
      },
      "Body_upload_list_v1_lists_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "signals": {
            "type": "boolean",
            "title": "Signals",
            "default": true
          },
          "ai": {
            "type": "boolean",
            "title": "Ai",
            "default": false
          },
          "mode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mode"
          },
          "max_cost_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Cost Usd"
          },
          "push_to_clay": {
            "type": "boolean",
            "title": "Push To Clay",
            "default": false
          },
          "clay_webhook_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clay Webhook Url"
          },
          "callback_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Callback Url"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_list_v1_lists_upload_post"
      },
      "CheckIn": {
        "properties": {
          "domain": {
            "type": "string",
            "title": "Domain",
            "description": "Company website, e.g. acme.com",
            "examples": [
              "linear.app"
            ]
          },
          "company": {
            "type": "string",
            "title": "Company",
            "default": ""
          },
          "employees": {
            "type": "string",
            "title": "Employees",
            "description": "Employee count, used for the size segment",
            "default": ""
          },
          "signals": {
            "type": "boolean",
            "title": "Signals",
            "description": "Also run phase 2 (signals and lead score) if the company is ICP",
            "default": true
          },
          "ai": {
            "type": "boolean",
            "title": "Ai",
            "description": "Also run the AI step (costs money; capped by ai_options.max_cost_usd)",
            "default": false
          },
          "ai_options": {
            "$ref": "#/components/schemas/AiOptions",
            "default": {
              "web": true,
              "search_signals": true
            }
          },
          "refresh": {
            "type": "boolean",
            "title": "Refresh",
            "description": "Download the website again instead of using the cache",
            "default": false
          },
          "wait_seconds": {
            "type": "number",
            "title": "Wait Seconds",
            "description": "Answer within this time; longer checks keep running, ask again",
            "default": 45
          }
        },
        "type": "object",
        "required": [
          "domain"
        ],
        "title": "CheckIn"
      },
      "EvaluateIn": {
        "properties": {
          "labels": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Labels",
            "description": "Right answers: Domain, Expected ICP (YES/NO), Expected tier (Strong fit/Weak fit), 'Expected: <data point>' (Yes/No). Leave out to use Expected columns in the list itself",
            "examples": [
              [
                {
                  "Domain": "linear.app",
                  "Expected ICP": "YES",
                  "Expected tier": "Strong fit",
                  "Expected: Delaware C-Corp": "Yes"
                }
              ]
            ]
          }
        },
        "type": "object",
        "title": "EvaluateIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ListIn": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "List name; default is generated"
          },
          "rows": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Rows",
            "description": "Rows with at least a Domain (or Website) column; other columns are kept",
            "examples": [
              [
                {
                  "Company Name": "Linear",
                  "Domain": "linear.app",
                  "Owner": "Sam"
                }
              ]
            ]
          },
          "signals": {
            "type": "boolean",
            "title": "Signals",
            "default": true
          },
          "ai": {
            "type": "boolean",
            "title": "Ai",
            "description": "Run the AI step after each phase (costs money; capped)",
            "default": false
          },
          "ai_options": {
            "$ref": "#/components/schemas/AiOptions",
            "default": {
              "web": true,
              "search_signals": true
            }
          },
          "push_to_clay": {
            "type": "boolean",
            "title": "Push To Clay",
            "description": "When done, push every row to a Clay table webhook",
            "default": false
          },
          "clay_webhook_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clay Webhook Url",
            "description": "Clay webhook; default is CLAY_WEBHOOK_URL from settings"
          },
          "callback_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Callback Url",
            "description": "When done, POST the list's status and summary to this URL"
          }
        },
        "type": "object",
        "required": [
          "rows"
        ],
        "title": "ListIn"
      },
      "PullIn": {
        "properties": {
          "table_id": {
            "type": "string",
            "title": "Table Id",
            "description": "Clay table id, e.g. t_abc123 (see GET /v1/clay/tables)"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "limit": {
            "type": "integer",
            "title": "Limit",
            "description": "Only the first N rows (0 = all)",
            "default": 0
          },
          "signals": {
            "type": "boolean",
            "title": "Signals",
            "default": true
          },
          "ai": {
            "type": "boolean",
            "title": "Ai",
            "default": false
          },
          "ai_options": {
            "$ref": "#/components/schemas/AiOptions",
            "default": {
              "web": true,
              "search_signals": true
            }
          },
          "push_to_clay": {
            "type": "boolean",
            "title": "Push To Clay",
            "default": false
          },
          "clay_webhook_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clay Webhook Url"
          },
          "callback_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Callback Url"
          }
        },
        "type": "object",
        "required": [
          "table_id"
        ],
        "title": "PullIn"
      },
      "PushIn": {
        "properties": {
          "clay_webhook_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clay Webhook Url"
          },
          "only_icp": {
            "type": "boolean",
            "title": "Only Icp",
            "description": "Push only rows where ICP = YES",
            "default": false
          }
        },
        "type": "object",
        "title": "PushIn"
      },
      "RulesIn": {
        "properties": {
          "phase": {
            "type": "string",
            "enum": [
              "icp",
              "signals",
              "both"
            ],
            "title": "Phase",
            "default": "both"
          }
        },
        "type": "object",
        "title": "RulesIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "Companies",
      "description": "Check one company while you wait."
    },
    {
      "name": "Lists",
      "description": "Run whole lists in the background, follow progress, get results."
    },
    {
      "name": "AI",
      "description": "Cost estimates and the AI step for an existing list. Always estimated first and capped."
    },
    {
      "name": "Quality",
      "description": "Accuracy against right answers, and the run log."
    },
    {
      "name": "Reference",
      "description": "Free directory lookups and the list of data points."
    },
    {
      "name": "Clay",
      "description": "Pull lists from Clay and push results to a Clay table."
    }
  ]
}
