{
  "openapi": "3.1.0",
  "info": {
    "title": "PuzzleLeadScoring API",
    "description": "Check companies against Puzzle's ICP, score them, and exchange lists with other tools. Every /v1 call needs the header `x-api-key`. AI only runs when asked, within a cost limit.",
    "version": "2.0"
  },
