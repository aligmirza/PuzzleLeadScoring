          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/check": {
      "post": {
        "tags": [
          "Companies"
        ],
        "summary": "Check",
        "description": "One company, answered while you wait: ICP YES/NO/PENDING with the reason, lead score, tier, reasoning and\nevery data point. Cached, so asking again is instant. Use this from a Clay HTTP API column.",
        "operationId": "check_v1_check_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
