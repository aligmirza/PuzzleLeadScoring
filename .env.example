# PuzzleLeadScoring settings. Set each key once; never commit the filled-in .env.
# Keys marked 'not used yet' are reserved for planned integrations.


# --- This project ------------------------------------------------
# Key callers (Clay, teammates, tools) send to our API as the x-api-key header
# Get it: Created automatically by `python -m enrich settings`
PUZZLE_API_KEY=
# Password people enter once to connect Claude to the hosted MCP connector
# Get it: Created automatically by `python -m enrich mcp --http`
MCP_CONNECTOR_PASSWORD=

# --- AI ----------------------------------------------------------
# AI step (gpt-4o-mini): answers prompts and runs the web search step
# Get it: platform.openai.com > API keys
OPENAI_API_KEY=
# Alternative AI provider (Claude); set provider to anthropic in config/prompts/_shared.json (not used yet)
# Get it: console.anthropic.com > API keys
ANTHROPIC_API_KEY=

# --- Clay --------------------------------------------------------
# Default Clay table to push results to (the table's Webhook source URL)
# Get it: Clay table > Add source > Webhook > copy URL
CLAY_WEBHOOK_URL=
# Auth token of that webhook, if you turned one on
# Get it: Clay table > Webhook source settings
CLAY_WEBHOOK_TOKEN=
# Clay table for contacts (one row per person, from LeadMagic or Prospeo), its own Webhook source URL
# Get it: contacts table > Add source > Webhook > copy URL
CLAY_CONTACTS_WEBHOOK_URL=
# Clay Public API (search, tables, routines over HTTP). Pull and push work without it, through `clay login` (not used yet)
# Get it: `clay api-keys create --name puzzle-lead-scoring` (shown once)
CLAY_API_KEY=

# --- This project ------------------------------------------------
# Folder for all data (lists, caches). Default: the project folder
# Get it: any folder, e.g. /Volumes/External/puzzle-data
DATA_DIR=
# Cap on AI spending per calendar month across terminal, API, MCP and trace (blank: no cap)
# Get it: your choice, e.g. 50
AI_MONTHLY_BUDGET_USD=
# Reuse pages and AI answers across lists: on (default) or off. Freshness: SHARED_PAGES_DAYS (30), SHARED_AI_DAYS (60), SHARED_WEB_DAYS (30), SHARED_RECENT_DAYS (14)
# Get it: on or off
SHARED_CACHE=
# Highest AI cost one API request may run (estimated first; above it the request is refused). Default 5
# Get it: your choice, e.g. 5
API_AI_MAX_COST_USD=
# Learning loop: 1 (default) applies safe fixes automatically and reports them; 0 = everything waits for approval
# Get it: 1 or 0
LEARNING_AUTO_APPLY=

# --- Free directories --------------------------------------------
# Contact email sent to SEC EDGAR in the User-Agent, as SEC asks of automated tools (optional; lookups work without it)
# Get it: any email the SEC can reach you at
SEC_CONTACT_EMAIL=

# --- Data providers ----------------------------------------------
# LeadMagic (Puzzle's provider, used first): people at a company (contacts and the finance check), company data, work emails and mobile numbers
# Get it: app.leadmagic.io > API > API key
LEADMAGIC_API_KEY=
# Cap on LeadMagic credits per calendar month (blank: no cap)
# Get it: your choice, e.g. 500
LEADMAGIC_MONTHLY_CREDITS=
# People asked for per company search (default 25; 1 credit each unless the plan includes search)
# Get it: a number from 1 to 50
LEADMAGIC_PEOPLE_LIMIT=
# Prospeo: the same people and company data, used only without a LeadMagic key
# Get it: app.prospeo.io > API > API key
PROSPEO_API_KEY=
# Cap on Prospeo credits per calendar month (blank: no cap)
# Get it: your choice, e.g. 500
PROVIDER_MONTHLY_CREDITS=
# Force one provider for people and company data: leadmagic or prospeo (blank: LeadMagic when its key is set)
# Get it: leadmagic or prospeo
CONTACTS_PROVIDER=

# --- Other data tools (planned) ----------------------------------
# Funding rounds and stage (not used yet)
# Get it: crunchbase.com > API
CRUNCHBASE_API_KEY=
# Headcount, LinkedIn, people at the company (not used yet)
# Get it: apollo.io > Settings > API
APOLLO_API_KEY=
# People Data Labs: company size, industry (not used yet)
# Get it: peopledatalabs.com > API keys
PDL_API_KEY=
# A separate web search service (Exa, Tavily or Serper), if not using OpenAI's (not used yet)
# Get it: the service's dashboard
SEARCH_API_KEY=
