{
  "id": "E4",
  "name": "Mainly operates outside the US",
  "group": "exclusion",
  "steps": {
    "rules": {
      "on": true
    },
    "directories": {
      "on": true
    },
    "ai_pages": {
      "run": "if_open",
      "prompt": "exclusions/outside_us"
    },
    "ai_web": {
      "run": "if_open",
      "when_site_unreached": false
    },
    "provider": {
      "run": "off",
      "provider": "prospeo"
    }
  },
  "covers": {
    "directories": true,
    "provider": true
  }
}
