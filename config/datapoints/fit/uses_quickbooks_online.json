{
  "id": "F4",
  "name": "Uses QuickBooks Online",
  "group": "fit",
  "steps": {
    "rules": {
      "on": true
    },
    "directories": {
      "on": true
    },
    "ai_pages": {
      "run": "if_open",
      "prompt": "fit/uses_quickbooks_online"
    },
    "ai_web": {
      "run": "if_open",
      "when_site_unreached": false
    },
    "provider": {
      "run": "off",
      "provider": "prospeo"
    }
  },
  "covers": {
    "directories": true,
    "provider": true
  }
}
