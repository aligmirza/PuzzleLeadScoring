{
  "id": "weak/heavy_ar_ap",
  "data_point": "Heavy accounts-receivable or accounts-payable workflows",
  "group": "Weak fit signal",
  "signal_id": "W8",
  "profile_section": "weak_fit_signals",
  "weight": "penalty",
  "version": 1,
  "stage": "site_text",
  "model": "small",
  "run_when": "Always, for companies still in the running.",
  "input": {
    "pages": [
      "home",
      "pricing",
      "about"
    ],
    "extra": [],
    "max_chars_per_page": 4000
  },
  "prompt": {
    "task": "Decide whether the company runs heavy invoicing or bill-paying workflows (a known product gap).",
    "definition": "This lowers the score but never disqualifies.",
    "yes_when": [
      "Wholesale or distribution",
      "Large B2B contracts paid by invoice on net terms",
      "'Request an invoice' as the main way to buy"
    ],
    "no_when": [
      "Self-serve card payments or subscriptions"
    ],
    "unknown_when": [
      "Unclear"
    ],
    "watch_out_for": [
      "Enterprise 'contact sales' alone isn't enough"
    ],
    "where_to_look": [
      "Pricing page",
      "Homepage"
    ]
  },
  "output": {
    "format": "json",
    "schema": {
      "type": "object",
      "required": [
        "answer",
        "confidence",
        "evidence_quote",
        "source",
        "reason"
      ],
      "properties": {
        "answer": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence_quote": {
          "type": "string",
          "description": "Exact words copied from the text. Empty when the answer is unknown."
        },
        "source": {
          "type": "string",
          "description": "Page name or URL the quote came from."
        },
        "reason": {
          "type": "string",
          "description": "One plain sentence explaining the answer."
        }
      }
    }
  },
  "web_search": {
    "mode": "fallback",
    "queries": [
      "\"{company}\" wholesale OR distributor OR invoice"
    ],
    "good_sources": [
      "company website",
      "press"
    ]
  },
  "examples": []
}
